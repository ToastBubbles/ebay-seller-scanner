{
  "name": "ebay-scanner",
  "version": "1.0.0",
  "description": "Scans ebay periodically and notifies you when items are listed",
  "license": "ISC",
  "author": "ToastBubbles",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^37.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.toastbubbles.ebayscanner",
    "productName": "eBay Scanner",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "images/icon.png"
    }
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "axios": "^1.11.0"
  }
}
